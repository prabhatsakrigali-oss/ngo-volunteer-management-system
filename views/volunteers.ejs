<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>All Volunteers</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"  rel="stylesheet">

</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark">

    <div class="container justify-content-center">

        <a class="navbar-brand fw-bold text-white me-4" href="/">
            Niwala Foundation
        </a>

        <a class="nav-link text-white" href="/dashboard">
            Dashboard
        </a>

        <a class="nav-link text-white" href="/donations">
            Donations
        </a>

        <a class="nav-link text-white" href="/logout">
            Logout
        </a>

        <a class="nav-link text-white" href="/create-group">
           Create Group
        </a>

        <a class="nav-link text-white" href="/groups">
           Groups
        </a>
       <a class="nav-link text-white" href="/register">
          Register
       </a>

    </div>

<button
    onclick="toggleDarkMode()"
    class="btn btn-outline-light ms-3">

    🌙

</button>
</nav>

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-body">

            <h1 class="text-center mb-4">
                All Volunteers
            </h1>
                 <% if (message) { %>

                        <div class="alert alert-danger text-center">

                           <%= message %>
 
                         </div>

                   <% } %>


                    <form action="/search-volunteers" method="GET"class="mb-4 d-flex">

                          <input  type="text"   name="search"   class="form-control me-2" placeholder="Search Volunteer Name">

                          <button type="submit"  class="btn btn-primary">   Search   </button> 
                   </form>


                  <form action="/filter-role" method="GET" class="mb-4 d-flex"> 
                        

				<select name="role" class="form-select me-2">

				    <option value="All">
				        All Roles
				    </option>

				    <option value="Leader">
				        Leader
				    </option>

				    <option value="Volunteer">
				        Volunteer
				    </option>

				    <option value="Member">
				        Member
				    </option>

				</select>
 
                       <button  type="submit"  class="btn btn-success">

                         Filter Role
                       </button>
                 </form>
                   

            <div class="table-responsive">

                <table class="table table-bordered table-hover">

                    <thead class="table-dark">

                        <tr>
                            <th>Photo</th>

                            <th>Name</th>

                            <th>Email</th>

                            <th>Phone</th>

                            <th>Role</th>

                            <th>Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% volunteers.forEach((volunteer) => { %>

                        <tr>

                             <td> 
                               <img src="/uploads/<%= volunteer.photo %>"   width="60"   height="60" class="rounded-circle">
                            </td>
                            
                            <td>
                                <%= volunteer.name %>
                            </td>

                            <td>
                                <%= volunteer.email %>
                            </td>

                            <td>
                                <%= volunteer.phone %>
                            </td>

                            <td>
                                <%= volunteer.role %>
                            </td>

                            <td>

                                <a
                                href="/edit-volunteer/<%= volunteer._id %>"
                                class="btn btn-warning btn-sm">

                                    Edit

                                </a>

                                <a
                                href="/delete-volunteer/<%= volunteer._id %>"
                                class="btn btn-danger btn-sm">

                                    Delete

                                </a>

				<a href="/volunteer-id/<%= volunteer._id %>"
				   target="_blank"
				   class="btn btn-dark btn-sm">

				    Download ID Card

				</a>

				<a href="/certificate/<%= volunteer._id %>"
				   target="_blank"
				   class="btn btn-success btn-sm">

				    Download Certificate

				</a>

                            </td>

                        </tr>

                        <% }) %>

                    </tbody>

                </table>
<nav class="mt-4">

    <ul class="pagination justify-content-center">

        <% if (currentPage > 1) { %>

            <li class="page-item">

                <a
                class="page-link"
                href="/volunteers?page=<%= currentPage - 1 %>">

                    Previous

                </a>

            </li>

        <% } %>

        <% for(let i = 1; i <= totalPages; i++) { %>

            <li class="page-item <%= currentPage === i ? 'active' : '' %>">

                <a
                class="page-link"
                href="/volunteers?page=<%= i %>">

                    <%= i %>

                </a>

            </li>

        <% } %>

        <% if (currentPage < totalPages) { %>

            <li class="page-item">

                <a
                class="page-link"
                href="/volunteers?page=<%= currentPage + 1 %>">

                    Next

                </a>

            </li>

        <% } %>

    </ul>

</nav>


            </div>

        </div>

    </div>

</div>

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

<script src="/js/darkmode.js"></script>
</body>
</html>
