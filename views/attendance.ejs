<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Attendance System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark">

    <div class="container d-flex align-items-center">

        <a class="navbar-brand fw-bold text-white me-4"
           href="/">

            Niwala Foundation

        </a>

        <a class="nav-link text-white me-3"
           href="/dashboard">

            Dashboard

        </a>

        <a class="nav-link text-white me-3"
           href="/volunteers">

            Volunteers

        </a>

        <a class="nav-link text-white me-3"
           href="/groups">

            Groups

        </a>

        <a class="nav-link text-white me-3"
           href="/attendance">

            Attendance

        </a>

        <button
            onclick="toggleDarkMode()"
            class="btn btn-outline-light ms-3">

            🌙

        </button>

    </div>

</nav>

<div class="container mt-4">

    <h1 class="text-center mb-5">

        Attendance System

    </h1>

    <!-- FILTER -->

    <div class="card shadow p-4 mb-4">

        <form action="/attendance"
              method="GET"
              class="row g-3 align-items-center">

            <div class="col-md-2">

                <select
                name="volunteer"
                class="form-control">

                    <option value="">All Volunteers</option>

                    <% volunteers.forEach(volunteer => { %>

                        <option value="<%= volunteer.name %>">

                            <%= volunteer.name %>

                        </option>

                    <% }) %>

                </select>

            </div>

            <div class="col-md-2">

                <input
                type="month"
                name="month"
                class="form-control">

            </div>

            <div class="col-md-3">

                <input
                type="date"
                name="date"
                class="form-control">

            </div>

            <div class="col-md-2">

                <button
                type="submit"
                class="btn btn-dark w-100">

                    Filter

                </button>

            </div>

            <div class="col-md-2">

                <a
                href="/attendance"
                class="btn btn-secondary w-100">

                    Reset

                </a>

            </div>

        </form>

    </div>

    <!-- MARK ATTENDANCE -->

    <div class="card shadow p-4 mb-5">

        <form action="/mark-attendance"
              method="POST">

            <div class="mb-3">

                <label class="form-label">

                    Volunteer Name

                </label>

                <select
                name="volunteerId"
                class="form-control"
                required>

                    <option value="">Select Volunteer</option>

                    <% volunteers.forEach(volunteer => { %>

                        <option value="<%= volunteer._id %>">

                            <%= volunteer.name %> - <%= volunteer.role %>

                        </option>

                    <% }) %>

                </select>

            </div>

            <div class="mb-4">

                <label class="form-label">

                    Status

                </label>

                <select
                name="status"
                class="form-control">

                    <option value="Present">Present</option>

                    <option value="Absent">Absent</option>

                    <option value="Leave">Leave</option>

                </select>

            </div>

            <button
            type="submit"
            class="btn btn-primary w-100">

                Mark Attendance

            </button>

        </form>

    </div>

    <!-- ANALYTICS -->

    <div class="card shadow p-4 mb-5">

        <h3 class="mb-4 text-center">

            Attendance Analytics

        </h3>

        <div class="text-end mb-3 fw-bold">

            Present: <%= presentCount %> |

            Absent: <%= absentCount %> |

            Leave: <%= leaveCount %>

        </div>

        <div style="max-width: 700px; height: 350px; margin: auto;">

            <canvas id="attendanceChart"></canvas>

        </div>

    </div>

    <!-- RECORDS -->

    <div class="card shadow p-4">

        <h3 class="mb-4">

            Attendance Records

        </h3>

        <table class="table table-bordered">

            <thead>

                <tr>

                    <th>Name</th>

                    <th>Role</th>

                    <th>Status</th>

                    <th>Date</th>

                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

                <% attendance.forEach(item => { %>

                    <tr class="<%= item.date.getDay() === 0 ? 'table-warning' : '' %>">

                        <td>

                            <%= item.volunteerName %>

                        </td>

                        <td>

                            <%= item.role %>

                        </td>

                        <td>

                            <%= item.status %>

                        </td>

                        <td>

                            <%= item.date.toDateString() %>

                        </td>

                        <td>

                            <a  href="/delete-attendance/<%= item._id %>"   class="btn btn-danger btn-sm"
                            onclick="return confirm('Delete Attendance Record?')">

                                Delete

                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

        <!-- PAGINATION -->

        <div class="d-flex justify-content-center align-items-center mt-4">

            <% if (currentPage > 1) { %>

                <a
                href="/attendance?page=<%= currentPage - 1 %>"
                class="btn btn-dark me-3">

                    Previous

                </a>

            <% } %>

            <span class="fw-bold me-3">

                Page <%= currentPage %> of <%= totalPages %>

            </span>

            <% if (currentPage < totalPages) { %>

                <a
                href="/attendance?page=<%= currentPage + 1 %>"
                class="btn btn-dark">

                    Next

                </a>

            <% } %>

        </div>

    </div>

</div>

<script src="/js/darkmode.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

const ctx = document.getElementById('attendanceChart');

new Chart(ctx, {

    type: 'bar',

    data: {

        labels: [

            'Present',

            'Absent',

            'Leave'

        ],

        datasets: [{

            label: 'Attendance Count',

            data: [

                <%= presentCount %>,

                <%= absentCount %>,

                <%= leaveCount %>

            ],

            backgroundColor: [

                "#198754",

                "#dc3545",

                "#ffc107"

            ],

            borderWidth: 1

        }]

    },

    options: {

        responsive: true,

        maintainAspectRatio: false

    }

});

</script>

</body>
</html>
