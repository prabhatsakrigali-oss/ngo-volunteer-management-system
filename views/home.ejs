<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Niwala Foundation</title>

    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<%- include("partials/navbar") %>

<section class="container mt-5 mb-5">

    <div class="row align-items-center">

        <div class="col-md-6 text-center">

            <h1 class="display-3 fw-bold text-primary">

                We Help Poor Children

            </h1>

            <p class="lead mt-4">

                Join Niwala Foundation to support
                food distribution, education,
                and social welfare.

            </p>

            <a href="/donate"
               class="btn btn-primary btn-lg mt-3">

                Donate Now

            </a>

        </div>

        <div class="col-md-6 text-center">

            <img
            src="/images/6.jpeg"
            class="img-fluid rounded-4 shadow-lg"
            width="450">

        </div>

    </div>

</section>

<section class="container mt-5">

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card shadow border-0 rounded-4 h-100">

                <div class="card-body text-center">

                    <h3>Food Donation</h3>

                    <p>
                        Helping poor families with healthy meals.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0 rounded-4 h-100">

                <div class="card-body text-center">

                    <h3>Child Education</h3>

                    <p>
                        Supporting education for needy children.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0 rounded-4 h-100">

                <div class="card-body text-center">

                    <h3>Community Help</h3>

                    <p>
                        Supporting poor communities together.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>
<section class="container mt-5">

    <h2 class="text-center mb-5 fw-bold">

        Our NGO Activities

    </h2>

    <div class="row g-4">

        <div class="col-md-4">

            <img
            src="/images/1.png"
            class="img-fluid rounded-4 shadow">

        </div>

        <div class="col-md-4">

            <img
            src="/images/2.png"
            class="img-fluid rounded-4 shadow">

        </div>

        <div class="col-md-4">

            <img
            src="/images/3.png"
            class="img-fluid rounded-4 shadow">

        </div>

        <div class="col-md-6">

            <img
            src="/images/4.png"
            class="img-fluid rounded-4 shadow">

        </div>

       
    </div>

</section>
<section class="container mt-5">

    <h2 class="text-center mb-4">

        Recent NGO Activities

    </h2>

    <div class="row">

        <% activities.forEach(activity => { %>

            <div class="col-md-6 mb-3">

                <div class="card shadow border-0 rounded-4">

                    <div class="card-body">

                        <h5>

                            <%= activity.message %>

                        </h5>

                        <small class="text-muted">

                            <%= activity.createdAt.toDateString() %>

                        </small>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</section>

<footer class="bg-dark text-white text-center p-3 mt-5">

    <p>
        © 2026 Niwala Foundation
    </p>

</footer>

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>
<script src="/js/darkmode.js"></script>
</body>
</html>
