<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Edit Group</title>

    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-light">
	<div class="text-end p-3">

	    <button
	        onclick="toggleDarkMode()"
	        class="btn btn-dark">

	        🌙

	    </button>

	</div>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-body p-5">

                    <h1 class="text-center mb-4">

                        Edit Group

                    </h1>

                    <form
                    action="/update-group/<%= group._id %>"
                    method="POST">

                        <div class="mb-3">

                            <label class="form-label">

                                Group Name

                            </label>

                            <input
                            type="text"
                            name="groupName"
                            class="form-control"
                            value="<%= group.groupName %>"
                            required>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">

                                Leader Name

                            </label>

                            <input
                            type="text"
                            name="leaderName"
                            class="form-control"
                            value="<%= group.leaderName %>"
                            required>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">

                                Total Members

                            </label>

                            <input
                            type="number"
                            name="totalMembers"
                            class="form-control"
                            value="<%= group.totalMembers %>"
                            required>

                        </div>

                        <div class="mb-4">

                            <label class="form-label">

                                Work Details

                            </label>

                            <textarea
                            name="workDetails"
                            rows="5"
                            class="form-control"
                            required><%= group.workDetails %></textarea>

                        </div>

                        <button
                        type="submit"
                        class="btn btn-primary btn-lg w-100">

                            Update Group

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
<script src="/js/darkmode.js"></script>
</body>
</html>
