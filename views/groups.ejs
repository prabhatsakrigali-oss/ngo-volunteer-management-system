<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Volunteer Groups</title>

    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark">

    <div class="container justify-content-center">

        <a class="navbar-brand fw-bold text-white me-4" href="/">
            Niwala Foundation
        </a>

        <a class="nav-link text-white" href="/">
            Home
        </a>

        <a class="nav-link text-white" href="/dashboard">
            Dashboard
        </a>

        <a class="nav-link text-white" href="/create-group">
            Create Group
        </a>

        <a class="nav-link text-white" href="/volunteers">
            Volunteers
        </a>

        <a class="nav-link text-white" href="/logout">
            Logout
        </a>


      <a class="nav-link text-white" href="/register">
             Register
      </a>

    </div>
<button
    onclick="toggleDarkMode()"
    class="btn btn-outline-light ms-3">

    🌙

</button>
</nav>

<div class="container mt-5">

    
<h1 class="text-center mb-5 fw-bold">

    Volunteer Groups

</h1>

<% if (message) { %>

    <div class="alert alert-danger text-center">

        <%= message %>

    </div>

<% } %>

<form  action="/search-groups" method="GET" class="mb-4 d-flex">

    <input  type="text"   name="search"   class="form-control me-2"   placeholder="Search Group">

    <button   type="submit"  class="btn btn-primary">

        Search

    </button>

</form>

<form action="/search-members" method="GET" class="mb-4 d-flex">

    <input  type="text"  name="search" class="form-control me-2"  placeholder="Search Member">

    <button  type="submit"  class="btn btn-success">

        Search Member

    </button>

</form>

    <div class="row g-4">

        <% groups.forEach((group) => { %>

        <div class="col-md-6">

            <div class="card shadow-lg border-0 rounded-4 h-100">

                <div class="card-body">

                    <h2 class="text-primary mb-3">

                        <%= group.groupName %>

                    </h2>

                    <p>

                        <strong>Leader:</strong>

                        <%= group.leaderName %>

                    </p>

                    <p>

                        <strong>Total Members:</strong>

                        <%= group.totalMembers %>

                    </p>

                    <p>

                        <strong>Work Details:</strong>

                        <%= group.workDetails %>

                    </p>

<h5 class="mt-4">

    Members List

</h5>

<ul class="list-group mb-4">

    <% group.members.forEach((member) => { %>


<li class="list-group-item d-flex justify-content-between align-items-center">

    <span>

	       <%= member.memberName %>

	<br>

	<small class="text-muted">

	    <%= member.memberPhone %>

	</small>

    </span>

    <div>

        <a
        href="/edit-member/<%= group._id %>/<%= member._id %>"
        class="btn btn-warning btn-sm">

            Edit

        </a>

        <a
        href="/delete-member/<%= group._id %>/<%= member._id %>"
        class="btn btn-danger btn-sm"

        onclick="return confirm('Delete this member?')">

            Delete

        </a>

    </div>

</li>
   

    <% }) %>

</ul>

<a href="/edit-group/<%= group._id %>" class="btn btn-warning mb-3">

    Edit Group

</a>

<a href="/delete-group/<%= group._id %>" class="btn btn-danger mb-3 ms-2" onclick="return confirm('Are you sure you want to delete this group?')">

    Delete Group

</a>

<form  action="/add-member/<%= group._id %>" method="POST">

    <div class="input-group">

        <input
        type="text"
        name="memberName"
        class="form-control"
        placeholder="Enter Member Name"
        required>
	<input
	type="text"
	name="memberPhone"
	class="form-control ms-2"
	placeholder="Enter Phone Number"
	required>

        <button
        type="submit"
        class="btn btn-primary">

            Add Member

        </button>

    </div>

</form>
<hr>

<h5 class="mt-4">

    Add Group Activity

</h5>

<form action="/add-activity/<%= group._id %>" method="POST" enctype="multipart/form-data">

    <div class="mb-3">

        <textarea
        name="activityText"
        class="form-control"
        placeholder="Enter Activity Details"
        required></textarea>

    </div>

    <div class="mb-3">

        <input
        type="file"
        name="activityImage"
        class="form-control"
        required>

    </div>

    <button  type="submit"  class="btn btn-success">

        Upload Activity

    </button>

</form>

<hr>

<h5 class="mt-4">

    Group Activities

</h5>

<% group.activities.forEach((activity) => { %>

    <div class="card mt-3 shadow border-0">

        <div class="card-body">

            <p>

                <%= activity.activityText %>

            </p>

            <img
            src="/uploads/<%= activity.activityImage %>"
            class="img-fluid rounded mt-3"
            width="300">

        </div>

    </div>

<% }) %>

                   <p class="text-muted">

                        Created:
                        <%= group.createdAt.toDateString() %>

                    </p>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

</div>

<nav class="mt-5">

    <ul class="pagination justify-content-center">

        <% if (currentPage > 1) { %>

            <li class="page-item">

                <a
                class="page-link"
                href="/groups?page=<%= currentPage - 1 %>">

                    Previous

                </a>

            </li>

        <% } %>

        <% for(let i = 1; i <= totalPages; i++) { %>

            <li class="page-item <%= currentPage === i ? 'active' : '' %>">

                <a
                class="page-link"
                href="/groups?page=<%= i %>">

                    <%= i %>

                </a>

            </li>

        <% } %>

        <% if (currentPage < totalPages) { %>

            <li class="page-item">

                <a
                class="page-link"
                href="/groups?page=<%= currentPage + 1 %>">

                    Next

                </a>

            </li>

        <% } %>

    </ul>

</nav>

<footer class="bg-dark text-white text-center p-3 mt-5">

    <p>
        © 2026 Niwala Foundation
    </p>

</footer>

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>
<script src="/js/darkmode.js"></script>

</body>
</html>
