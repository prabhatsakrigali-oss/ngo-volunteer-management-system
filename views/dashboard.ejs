<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

   <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>

<body class="bg-light">
<!-- ============================================================================================================== -->

<div class="d-flex">

    <!-- SIDEBAR -->

    <div class="bg-dark text-white p-3"
         style="width: 260px; min-height: 100vh;">

        <h3 class="text-center mb-4">

            NGO Admin

        </h3>

        <a href="/dashboard"
           class="btn btn-dark w-100 text-start mb-2">

            📊 Dashboard

        </a>

	   <a href="/"
	   class="btn btn-dark w-100 text-start mb-2">

	    🏠 Home

	</a>

	<a href="/about"
	   class="btn btn-dark w-100 text-start mb-2">

	    ℹ️ About

	</a>

	<a href="/donate"
	   class="btn btn-dark w-100 text-start mb-2">

	    💖 Donate

	</a>

	<a href="/create-group"
	   class="btn btn-dark w-100 text-start mb-2">

	    ➕ Create Group

	</a>

	<a href="/register"
	   class="btn btn-dark w-100 text-start mb-2">

	    📝 Register

	</a>

	        <a href="/volunteers"
	           class="btn btn-dark w-100 text-start mb-2">

	            👥 Volunteers

	        </a>

        <a href="/donations"
           class="btn btn-dark w-100 text-start mb-2">

            💰 Donations

        </a>

        <a href="/groups"
           class="btn btn-dark w-100 text-start mb-2">

            👨‍👩‍👧 Groups

        </a>

        <a href="/attendance"
           class="btn btn-dark w-100 text-start mb-2">

            📅 Attendance

        </a>

        <a href="/career-applications"
           class="btn btn-dark w-100 text-start mb-2">

            💼 Careers Applications

        </a>

	<a href="/events"
	   class="btn btn-dark w-100 text-start mb-2">

	    🎉 Events

	</a>

	<a href="/add-event"
	   class="btn btn-dark w-100 text-start mb-2">

	    ➕ Add Event

	</a>

	<a href="/add-gallery"
	   class="btn btn-dark w-100 text-start mb-2">

	    🖼️ Add Gallery

	</a>

        <a href="/admin-profile"
           class="btn btn-dark w-100 text-start mb-2">

            👤 Admin Profile

        </a>

        <a href="/logout"
           class="btn btn-danger w-100 mt-4">

            Logout

        </a>

        <button
            onclick="toggleDarkMode()"
            class="btn btn-outline-light w-100 mt-3">

            🌙 Dark Mode

        </button>

    </div>

    <!-- MAIN CONTENT -->

    <div class="flex-grow-1 p-4">

<!-- ============================================================================================================== -->

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold">
            Niwala Foundation Dashboard
        </h1>

		 <p class="text-muted">
            NGO Management System
        </p>

    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card bg-primary text-white shadow-lg border-0 rounded-4">

                <div class="card-body text-center p-4">

                    <h3>Total Volunteers</h3>

                    <h1 class="display-3 fw-bold">
                        <%= totalVolunteers %>
                    </h1>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card bg-success text-white shadow-lg border-0 rounded-4">

                <div class="card-body text-center p-4">

                    <h3>Total Donations</h3>

                    <h1 class="display-3 fw-bold">
                        <%= totalDonations %>
                    </h1>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card bg-warning text-dark shadow-lg border-0 rounded-4">

                <div class="card-body text-center p-4">

                    <h3>Total Amount</h3>

                    <h1 class="display-3 fw-bold">
                        ₹ <%= totalAmount %>
                    </h1>

                </div>

            </div>

        </div>

    </div>

    <div class="mt-5">

        <div class="card shadow-lg border-0 rounded-4">

            <div class="card-body text-center p-5">

                <h2 class="mb-4">
                    Quick Actions
                </h2>

                <a href="/volunteers"
                   class="btn btn-primary btn-lg m-2">

                    View Volunteers

                </a>

                <a href="/donations"
                   class="btn btn-success btn-lg m-2">

                    View Donations

                </a>

                <a href="/logout"
                   class="btn btn-danger btn-lg m-2">

                    Logout

                </a>

		<a href="/export-volunteers-pdf"
		   class="btn btn-dark btn-lg m-2">

		    Export Volunteers PDF

		</a>

		<a href="/export-donations-excel"
		   class="btn btn-secondary btn-lg m-2">

		    Export Donations Excel

		</a>

            </div>

        </div>

    </div>

<div class="card shadow-lg border-0 rounded-4 mt-5 p-4">

    <h3 class="text-center mb-4">

        NGO Analytics

    </h3>

    <canvas id="ngoChart" style="max-height: 300px;"></canvas>

</div>

<div class="card shadow-lg border-0 rounded-4 mt-5 p-4">

    <h3 class="text-center mb-4">

        Role Analytics

    </h3>

    <canvas id="roleChart" style="max-height: 300px;"></canvas>

</div>
<div class="card shadow-lg border-0 rounded-4 mt-5 p-4">

    <h3 class="text-center mb-4">

        Recent Activities

    </h3>

    <ul class="list-group">

        <% activities.forEach((activity) => { %>

            <li class="list-group-item">

                <strong>

                    <%= activity.message %>

                </strong>

                <br>

                <small class="text-muted">

                    <%= activity.createdAt.toDateString() %>

                </small>

            </li>

        <% }) %>

    </ul>

</div>


<!-- ============================================================================================================== -->

<footer class="bg-dark text-white text-center p-3 mt-5 rounded">

    <p class="mb-0">
        © 2026 Niwala Foundation
    </p>

</footer>
<!-- ============================================================================================================== -->

</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>

const ctx = document.getElementById('ngoChart');

new Chart(ctx, {

    type: 'bar',

    data: {

        labels: [

            'Volunteers',
            'Donations'

        ],

        datasets: [{

            label: 'NGO Analytics',

            data: [

                <%= totalVolunteers %>,
                <%= totalDonations %>

            ],

            borderWidth: 1

        }]

    },

    options: {

        responsive: true,

        scales: {

            y: {

                beginAtZero: true

            }

        }

    }

});

const roleCtx = document.getElementById('roleChart');

new Chart(roleCtx, {

    type: 'pie',

    data: {

        labels: [

            'Leaders',
            'Volunteers',
            'Members'

        ],

        datasets: [{

            label: 'Role Analytics',

            data: [

                <%= totalLeaders %>,
                <%= totalVolunteerRole %>,
                <%= totalMembersRole %>

            ],

            borderWidth: 1

        }]

    },

    options: {

        responsive: true

    }

});

</script>

<script src="/js/darkmode.js"></script>
</body>
</html>
