<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Career - Niwala Foundation</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-light" id="body">

<!-- ================= NAVBAR ================= -->

<%- include("partials/navbar") %>

<!-- ================= HERO SECTION ================= -->

<section class="py-5 text-center bg-dark text-white">

    <div class="container">

        <h1 class="display-4 fw-bold">

            Join Our Mission

        </h1>

        <p class="lead mt-3">

            Become part of Niwala Foundation and help create positive social impact.

        </p>

    </div>

</section>

<!-- ================= JOB CARDS ================= -->

<div class="container mt-5 mb-5">

    <div class="row g-4">

        <!-- CARD 1 -->

        <div class="col-md-4">

            <div class="card shadow h-100 border-0 rounded-4">

                <div class="card-body">

                    <h3 class="fw-bold">

                        Volunteer

                    </h3>

                    <p class="text-muted">

                        Help local communities through social work,
                        education and food distribution.

                    </p>

                    <ul>

                        <li>Flexible Hours</li>

                        <li>Field Work</li>

                        <li>Community Support</li>

                    </ul>

                    <a href="/apply-career"
                       class="btn btn-dark w-100 mt-3">

                        Apply Now

                    </a>

                </div>

            </div>

        </div>

        <!-- CARD 2 -->

        <div class="col-md-4">

            <div class="card shadow h-100 border-0 rounded-4">

                <div class="card-body">

                    <h3 class="fw-bold">

                        Team Leader

                    </h3>

                    <p class="text-muted">

                        Lead NGO teams and coordinate social activities.

                    </p>

                    <ul>

                        <li>Leadership Role</li>

                        <li>Team Management</li>

                        <li>Event Coordination</li>

                    </ul>

                    <a href="/apply-career"
                       class="btn btn-dark w-100 mt-3">

                        Apply Now

                    </a>

                </div>

            </div>

        </div>

        <!-- CARD 3 -->

        <div class="col-md-4">

            <div class="card shadow h-100 border-0 rounded-4">

                <div class="card-body">

                    <h3 class="fw-bold">

                        Social Worker

                    </h3>

                    <p class="text-muted">

                        Work directly with families and children to improve lives.

                    </p>

                    <ul>

                        <li>Field Support</li>

                        <li>Social Awareness</li>

                        <li>Public Interaction</li>

                    </ul>

                    <a href="/apply-career"
                       class="btn btn-dark w-100 mt-3">

                        Apply Now

                    </a>

                </div>

            </div>

        </div>

		<!-- CARD 4 -->

	<div class="col-md-4">

	    <div class="card shadow h-100 border-0 rounded-4">

	        <div class="card-body">

	            <h3 class="fw-bold">

	                Coordinator

	            </h3>

	            <p class="text-muted">

	                Manage NGO operations, volunteers and program activities efficiently.

	            </p>

	            <ul>

	                <li>Team Coordination</li>

	                <li>Program Management</li>

	                <li>Communication Skills</li>

	            </ul>

	            <a href="/apply-career"
	               class="btn btn-dark w-100 mt-3">

	                Apply Now

	            </a>

	        </div>

	    </div>

	</div>


    </div>

</div>

<!-- ================= FORM SECTION ================= -->




<!---------------------- Form End ---------------->
<script src="/js/darkmode.js"></script>

</body>
</html>
