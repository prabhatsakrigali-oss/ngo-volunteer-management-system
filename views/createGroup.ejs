<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Create Group</title>

    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark">

    <div class="container justify-content-center">

        <a class="navbar-brand fw-bold text-white me-4" href="/">
            Niwala Foundation
        </a>

        <a class="nav-link text-white" href="/">
            Home
        </a>

        <a class="nav-link text-white" href="/dashboard">
            Dashboard
        </a>

        <a class="nav-link text-white" href="/groups">
            Groups
        </a>

        <a class="nav-link text-white" href="/logout">
            Logout
        </a>

    </div>
<button
    onclick="toggleDarkMode()"
    class="btn btn-outline-light ms-3">

    🌙

</button>

</nav>

<section class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-body p-5">

                    <h1 class="text-center mb-4">

                        Create Volunteer Group

                    </h1>

                    <form action="/create-group"
                          method="POST">

                        <div class="mb-3">

                            <label class="form-label">

                                Group Name

                            </label>

                            <input
                                type="text"
                                name="groupName"
                                class="form-control"
                                required>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">

                                Group Leader Name

                            </label>

                            <input
                                type="text"
                                name="leaderName"
                                class="form-control"
                                required>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">

                                Total Members

                            </label>

                            <input
                                type="number"
                                name="totalMembers"
                                class="form-control"
                                required>

                        </div>

                        <div class="mb-4">

                            <label class="form-label">

                                Work Details

                            </label>

                            <textarea
                                name="workDetails"
                                rows="5"
                                class="form-control"
                                required>
                            </textarea>

                        </div>

                        <button
                            type="submit"
                            class="btn btn-primary btn-lg w-100">

                            Create Group

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>

<footer class="bg-dark text-white text-center p-3 mt-5">

    <p>
        © 2026 Niwala Foundation
    </p>

</footer>

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>
<script src="/js/darkmode.js"></script>
</body>
</html>
