<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

   <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark">

    <div class="container justify-content-center">

        <a class="navbar-brand fw-bold text-white me-4" href="/">
            Niwala Foundation
        </a>

        <a class="nav-link text-white" href="/">
            Home
        </a>

        <a class="nav-link text-white" href="/about">
            About
        </a>

        <a class="nav-link text-white" href="/donate">
            Donate
        </a>

        <a class="nav-link text-white" href="/volunteers">
            Volunteers
        </a>

        <a class="nav-link text-white" href="/donations">
            Donations
        </a>

        <a class="nav-link text-white" href="/logout">
            Logout
        </a>

        <a class="nav-link text-white" href="/create-group">
            Create Group
        </a>

        <a class="nav-link text-white" href="/groups">
           Groups
       </a>
       <a class="nav-link text-white" href="/register">
          Register
       </a>

      <a class="nav-link text-white" href="/admin-profile">
       Admin Profile
     </a>

      <a class="nav-link text-white"  href="/attendance">

          Attendance
      </a>
     
     <a class="nav-link text-white" href="/career-applications">
	    Career Applications
     </a>
  
     </div>

<button
    onclick="toggleDarkMode()"
    class="btn btn-outline-light ms-3">

    🌙

</button>

 </nav>

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold">
            Niwala Foundation Dashboard
        </h1>

		 <p class="text-muted">
            NGO Management System
        </p>

    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card bg-primary text-white shadow-lg border-0 rounded-4">

                <div class="card-body text-center p-4">

                    <h3>Total Volunteers</h3>

                    <h1 class="display-3 fw-bold">
                        <%= totalVolunteers %>
                    </h1>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card bg-success text-white shadow-lg border-0 rounded-4">

                <div class="card-body text-center p-4">

                    <h3>Total Donations</h3>

                    <h1 class="display-3 fw-bold">
                        <%= totalDonations %>
                    </h1>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card bg-warning text-dark shadow-lg border-0 rounded-4">

                <div class="card-body text-center p-4">

                    <h3>Total Amount</h3>

                    <h1 class="display-3 fw-bold">
                        ₹ <%= totalAmount %>
                    </h1>

                </div>

            </div>

        </div>

    </div>

    <div class="mt-5">

        <div class="card shadow-lg border-0 rounded-4">

            <div class="card-body text-center p-5">

                <h2 class="mb-4">
                    Quick Actions
                </h2>

                <a href="/volunteers"
                   class="btn btn-primary btn-lg m-2">

                    View Volunteers

                </a>

                <a href="/donations"
                   class="btn btn-success btn-lg m-2">

                    View Donations

                </a>

                <a href="/logout"
                   class="btn btn-danger btn-lg m-2">

                    Logout

                </a>

		<a href="/export-volunteers-pdf"
		   class="btn btn-dark btn-lg m-2">

		    Export Volunteers PDF

		</a>

		<a href="/export-donations-excel"
		   class="btn btn-secondary btn-lg m-2">

		    Export Donations Excel

		</a>

            </div>

        </div>

    </div>

<div class="card shadow-lg border-0 rounded-4 mt-5 p-4">

    <h3 class="text-center mb-4">

        NGO Analytics

    </h3>

    <canvas id="ngoChart" style="max-height: 300px;"></canvas>

</div>

<div class="card shadow-lg border-0 rounded-4 mt-5 p-4">

    <h3 class="text-center mb-4">

        Role Analytics

    </h3>

    <canvas id="roleChart" style="max-height: 300px;"></canvas>

</div>
<div class="card shadow-lg border-0 rounded-4 mt-5 p-4">

    <h3 class="text-center mb-4">

        Recent Activities

    </h3>

    <ul class="list-group">

        <% activities.forEach((activity) => { %>

            <li class="list-group-item">

                <strong>

                    <%= activity.message %>

                </strong>

                <br>

                <small class="text-muted">

                    <%= activity.createdAt.toDateString() %>

                </small>

            </li>

        <% }) %>

    </ul>

</div>

<footer class="bg-dark text-white text-center p-3 mt-5">

    <p>
        © 2026 Niwala Foundation
    </p>

</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>

const ctx = document.getElementById('ngoChart');

new Chart(ctx, {

    type: 'bar',

    data: {

        labels: [

            'Volunteers',
            'Donations'

        ],

        datasets: [{

            label: 'NGO Analytics',

            data: [

                <%= totalVolunteers %>,
                <%= totalDonations %>

            ],

            borderWidth: 1

        }]

    },

    options: {

        responsive: true,

        scales: {

            y: {

                beginAtZero: true

            }

        }

    }

});

const roleCtx = document.getElementById('roleChart');

new Chart(roleCtx, {

    type: 'pie',

    data: {

        labels: [

            'Leaders',
            'Volunteers',
            'Members'

        ],

        datasets: [{

            label: 'Role Analytics',

            data: [

                <%= totalLeaders %>,
                <%= totalVolunteerRole %>,
                <%= totalMembersRole %>

            ],

            borderWidth: 1

        }]

    },

    options: {

        responsive: true

    }

});

</script>

<script src="/js/darkmode.js"></script>
</body>
</html>
