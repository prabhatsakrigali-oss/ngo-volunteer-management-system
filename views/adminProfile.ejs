<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Admin Profile</title>

    <link rel="stylesheet" href="/css/style.css">

    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">

</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark">

    <div class="container justify-content-center">

        <a class="navbar-brand fw-bold text-white"
           href="/dashboard">

            Niwala Foundation

        </a>

        <button
            onclick="toggleDarkMode()"
            class="btn btn-outline-light ms-3">

            🌙

        </button>

    </div>

</nav>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-body text-center p-5">

                    <img
                        src="<%= admin.photo ? '/uploads/' + admin.photo : 'https://cdn-icons-png.flaticon.com/512/3135/3135715.png' %>"
			width="120"
			height="120"
			class="rounded-circle mb-4">

			<form action="/upload-admin-photo" method="POST" enctype="multipart/form-data" class="mb-4">

			    <input type="file"  name="photo" class="form-control mb-2"  required>

			    <button  type="submit"   class="btn btn-primary btn-sm">

			        Upload Photo

			    </button>

			</form>



                    <h2 class="fw-bold">

                        Admin Profile

                    </h2>

                    <hr>

                    <p>

                        <strong>Email:</strong>

                        <%= admin.email %>

                    </p>

                    <p>

                        <strong>Role:</strong>

                        Admin

                    </p>

                    <hr>

                    <h4 class="mb-3">

                        NGO Statistics

                    </h4>

                    <p>

                        Total Volunteers:
                        <strong><%= totalVolunteers %></strong>

                    </p>

                    <p>

                        Total Groups:
                        <strong><%= totalGroups %></strong>

                    </p>

                    <p>

                        Total Donations:
                        <strong><%= totalDonations %></strong>

                    </p>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="/js/darkmode.js"></script>

</body>

</html>
