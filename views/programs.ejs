<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Programs | Niwala Foundation</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="/css/style.css">

</head>

<body class="bg-light" id="body">

<!-- ================= NAVBAR ================= -->

<%- include("partials/navbar") %>

<!-- ================= HERO SECTION ================= -->

<section class="bg-primary text-white py-5">

    <div class="container text-center">

        <h1 class="display-4 fw-bold">

            Our Programs

        </h1>

        <p class="lead mt-3">

            Empowering communities through education,
            healthcare, food support, and skill development.

        </p>

    </div>

</section>

<!-- ================= PROGRAMS SECTION ================= -->

<div class="container py-5">

    <div class="row g-4">

        <!-- Education -->

        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100 border-0">

                <img src="https://images.unsplash.com/photo-1509062522246-3755977927d7"
                     class="card-img-top"
                     style="height: 220px; object-fit: cover;">

                <div class="card-body">

                    <h4 class="card-title fw-bold">

                        Education Support

                    </h4>

                    <p class="card-text">

                        We provide books, scholarships,
                        school kits, and free coaching
                        support for underprivileged children.

                    </p>

                </div>

            </div>

        </div>

        <!-- Food Distribution -->

        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100 border-0">

                <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c"
                     class="card-img-top"
                     style="height: 220px; object-fit: cover;">

                <div class="card-body">

                    <h4 class="card-title fw-bold">

                        Food Distribution

                    </h4>

                    <p class="card-text">

                        Weekly meal distribution drives
                        for poor families, homeless people,
                        and disaster affected communities.

                    </p>

                </div>

            </div>

        </div>

        <!-- Health Camp -->

        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100 border-0">

                <img src="https://images.unsplash.com/photo-1584515933487-779824d29309"
                     class="card-img-top"
                     style="height: 220px; object-fit: cover;">

                <div class="card-body">

                    <h4 class="card-title fw-bold">

                        Health Camps

                    </h4>

                    <p class="card-text">

                        Free medical checkups, blood donation
                        camps, and awareness programs for
                        rural communities.

                    </p>

                </div>

            </div>

        </div>

        <!-- Women Empowerment -->

        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100 border-0">

                <img src="https://images.unsplash.com/photo-1521791136064-7986c2920216"
                     class="card-img-top"
                     style="height: 220px; object-fit: cover;">

                <div class="card-body">

                    <h4 class="card-title fw-bold">

                        Women Empowerment

                    </h4>

                    <p class="card-text">

                        Skill development and self-employment
                        training programs for women and girls.

                    </p>

                </div>

            </div>

        </div>

        <!-- Environment -->

        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100 border-0">

                <img src="https://images.unsplash.com/photo-1492496913980-501348b61469"
                     class="card-img-top"
                     style="height: 220px; object-fit: cover;">

                <div class="card-body">

                    <h4 class="card-title fw-bold">

                        Environment Awareness

                    </h4>

                    <p class="card-text">

                        Tree plantation drives, cleanliness
                        campaigns, and environmental education
                        initiatives.

                    </p>

                </div>

            </div>

        </div>

        <!-- Youth Development -->

        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100 border-0">

                <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f"
                     class="card-img-top"
                     style="height: 220px; object-fit: cover;">

                <div class="card-body">

                    <h4 class="card-title fw-bold">

                        Youth Development

                    </h4>

                    <p class="card-text">

                        Leadership programs, volunteer
                        activities, and career guidance
                        workshops for youth.

                    </p>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- ================= FOOTER ================= -->

<footer class="bg-dark text-white text-center py-3">

    <p class="mb-0">

        © 2026 Niwala Foundation | All Rights Reserved

    </p>

</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="/js/darkmode.js"></script>
</body>
</html>
